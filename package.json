{
  "name": "random-seoul",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "generate:shell": "node scripts/extract-legacy-shell.mjs",
    "dev": "npm run generate:shell && vite",
    "build": "npm run generate:shell && tsc -b && vite build",
    "build:native": "npm run generate:shell && tsc -b && vite build --config vite.native.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync:android": "npm run build:native && cap sync android",
    "generate:footprint-anchors": "node scripts/generate-footprint-map-anchors.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.5.1",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
